{
    "module": "random",
    "summary": "Functions involving randomness",
    "officialBaseUrl": "https://docs.python.org/3/library/random.html",
    "elements": [
        {
            "kind": "function",
            "name": "randint",
            "description": {
                "p": [
                    "Returns a random integer between the two specified values, inclusive."
                ]
            },
            "parameters": [
                {
                    "name": "a",
                    "type": "int",
                    "description": "The lower bound of the range"
                },
                {
                    "name": "b",
                    "type": "int",
                    "description": "The upper bound of the range"
                }
            ],
            "returnValue": {
                "type": "int",
                "description": "A random integer between a and b, inclusive"
            },
            "sideEffects": true,
            "examples": [
                {
                    "code": "randint(1, 10)",
                    "result": "7"
                },
                {
                    "code": "randint(1, 10)",
                    "result": "10"
                }
            ],
            "urlSuffix": "#random.randint"
        },
        {
            "kind": "function",
            "name": "random",
            "description": {
                "p": [
                    "Returns a random floating point number between 0 (included) and 1 (excluded)."
                ]
            },
            "parameters": [],
            "returnValue": {
                "type": "float",
                "description": "A random floating point number between 0 and 1"
            },
            "sideEffects": true,
            "examples": [
                {
                    "code": "random()",
                    "result": "0.12345678901234567"
                },
                {
                    "code": "random()",
                    "result": "0.9876543210987654"
                }
            ],
            "urlSuffix": "#random.random"
        },
        {
            "kind": "function",
            "name": "choice",
            "description": {
                "p": [
                    "Returns a random element from the given sequence."
                ]
            },
            "parameters": [
                {
                    "name": "sequence",
                    "type": "Sequence[T]",
                    "description": "A sequence of elements"
                }
            ],
            "returnValue": {
                "type": "T",
                "description": "A random element from the sequence"
            },
            "sideEffects": true,
            "examples": [
                {
                    "code": "choice(['Lugano', 'Zürich', 'Genève'])",
                    "result": "'Lugano'"
                },
                {
                    "code": "choice(['Lugano', 'Zürich', 'Genève'])",
                    "result": "'Zürich'"
                },
                {
                    "code": "choice('Lugano')",
                    "result": "'g'"
                }
            ],
            "urlSuffix": "#random.choice"
        },
        {
            "kind": "function",
            "name": "choices",
            "description": {
                "p": [
                    "Returns a list with a random sample of elements from the given sequence.",
                    "Elements are sampled with equal probability, unless specific weights are provided. Weights do not need to be normalized to sum to 1."
                ]
            },
            "parameters": [
                {
                    "name": "sequence",
                    "type": "Sequence[T]",
                    "description": "A sequence of elements"
                },
                {
                    "name": "weights",
                    "type": "Sequence[float] | None",
                    "description": "When not `None`, a sequence of weights, one for each element in the sequence, which after normalization determine the probability of sampling each element",
                    "default": "None"
                },
                {
                    "name": "cum_weights",
                    "type": "Sequence[float] | None",
                    "description": "When not `None`, a sequence of cumulative weights (to be used as an alternative to weights)",
                    "default": "None"
                },
                {
                    "name": "k",
                    "type": "int",
                    "description": "The number of elements to sample",
                    "default": "1"
                }
            ],
            "returnValue": {
                "type": "List[T]",
                "description": "A list with `k` random elements from the sequence"
            },
            "sideEffects": true,
            "examples": [
                {
                    "code": "choices('Lugano')",
                    "result": "['g']"
                },
                {
                    "code": "choices(['Lugano', 'Zürich', 'Genève'], [999, 1, 1])",
                    "result": "['Lugano']",
                    "usesOptional": true
                },
                {
                    "code": "choices(['Lugano', 'Zürich', 'Genève'], [0.7, 0.3, 0], k=3)",
                    "result": "['Zürich', 'Lugano', 'Lugano']",
                    "usesOptional": true
                }
            ],
            "urlSuffix": "#random.choices"
        },
        {
            "kind": "function",
            "name": "shuffle",
            "description": {
                "p": [
                    "Shuffles the elements of the given sequence, mutating the parameter."
                ]
            },
            "parameters": [
                {
                    "name": "sequence",
                    "type": "Sequence[T]",
                    "description": "A sequence of elements which itself will be shuffled"
                }
            ],
            "sideEffects": true,
            "examples": [
                {
                    "code": "cities = ['Lugano', 'Zürich', 'Genève']\nshuffle(cities)\ncities",
                    "result": "['Zürich', 'Genève', 'Lugano']"
                },
                {
                    "code": "cities = ['Lugano', 'Zürich', 'Genève']\nshuffle(cities)\ncities",
                    "result": "['Genève', 'Lugano', 'Zürich']"
                }
            ],
            "urlSuffix": "#random.shuffle"
        },
        {
            "kind": "function",
            "name": "sample",
            "description": {
                "p": [
                    "Returns a list with `k` unique elements sampled from the given sequence.",
                    "This is known as 'sampling without replacement'."
                ]
            },
            "parameters": [
                {
                    "name": "sequence",
                    "type": "Sequence[T]",
                    "description": "A sequence of elements"
                },
                {
                    "name": "k",
                    "type": "int",
                    "description": "The number of elements to sample"
                },
                {
                    "name": "counts",
                    "type": "Sequence[int] | None",
                    "description": "When not `None`, a sequence of counts, one for each element in the sequence, to determine the number of times each element can be sampled",
                    "default": "None"
                }
            ],
            "returnValue": {
                "type": "List[T]",
                "description": "A list with `k` random elements from the sequence"
            },
            "sideEffects": true,
            "examples": [
                {
                    "code": "sample(['Lugano', 'Zürich', 'Genève'], k=2)",
                    "result": "['Lugano', 'Zürich']"
                },
                {
                    "code": "sample(['Lugano', 'Zürich', 'Genève'], k=3)",
                    "result": "['Zürich', 'Genève', 'Lugano']"
                }
            ],
            "urlSuffix": "#random.sample"
        }
    ]
} 