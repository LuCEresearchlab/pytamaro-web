{
    "module": "string",
    "summary": "Common constants for characters",
    "officialBaseUrl": "https://docs.python.org/3/library/string.html",
    "elements": [
        {
            "kind": "constant",
            "name": "ascii_lowercase",
            "type": "str",
            "description": {
                "p": ["Sequence of lowercase letters in the English alphabet."]
            },
            "examples": [
                {
                    "code": "ascii_lowercase",
                    "result": "'abcdefghijklmnopqrstuvwxyz'"
                }
            ],
            "urlSuffix": "#string.ascii_lowercase"
        },
        {
            "kind": "constant",
            "name": "ascii_uppercase",
            "type": "str",
            "description": {
                "p": ["Sequence of uppercase letters in the English alphabet."]
            },
            "examples": [
                {
                    "code": "ascii_uppercase",
                    "result": "'ABCDEFGHIJKLMNOPQRSTUVWXYZ'"
                }
            ],
            "urlSuffix": "#string.ascii_uppercase"
        },
        {
            "kind": "constant",
            "name": "ascii_letters",
            "type": "str",
            "description": {
                "p": ["Concatenation of the `ascii_lowercase` and `ascii_uppercase` constants."]
            },
            "examples": [
                {
                    "code": "ascii_letters",
                    "result": "'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ'"
                }
            ],
            "urlSuffix": "#string.ascii_letters"
        },
        {
            "kind": "constant",
            "name": "digits",
            "type": "str",
            "description": {
                "p": ["Sequence of decimal digits from `0` to `9`."]
            }
        },
        {
            "kind": "constant",
            "name": "hexdigits",
            "type": "str",
            "description": {
                "p": ["Sequence of hexadecimal digits from `0` to `9`, `a` to `f`, and also `A` to `F`."]
            },
            "examples": [
                {
                    "code": "hexdigits",
                    "result": "'0123456789abcdefABCDEF'"
                }
            ],
            "urlSuffix": "#string.hexdigits"
        },
        {
            "kind": "constant",
            "name": "octdigits",
            "type": "str",
            "description": {
                "p": ["Sequence of octal digits from `0` to `7`."]
            },
            "examples": [
                {
                    "code": "octdigits",
                    "result": "'01234567'"
                }
            ],
            "urlSuffix": "#string.octdigits"
        },
        {
            "kind": "constant",
            "name": "punctuation",
            "type": "str",
            "description": {
                "p": ["Sequence of ASCII characters which are considered punctuation: `!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~`"]
            },
            "examples": [
                {
                    "code": "punctuation",
                    "result": "'!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~'"
                }
            ],
            "urlSuffix": "#string.punctuation"
        },
        {
            "kind": "constant",
            "name": "printable",
            "type": "str",
            "description": {
                "p": ["Sequence of ASCII characters which are considered printable: `digits`, `ascii_letters`, `punctuation`, and `whitespace`."]
            },
            "examples": [
                {
                    "code": "printable",
                    "result": "'0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~ \\t\\n\\r\\x0b\\x0c'"
                }
            ],
            "urlSuffix": "#string.printable"
        },
        {
            "kind": "constant",
            "name": "whitespace",
            "type": "str",
            "description": {
                "p": ["Sequence of ASCII characters which are considered whitespace: space, tab, linefeed, return, formfeed, and vertical tab."]
            },
            "examples": [
                {
                    "code": "whitespace",
                    "result": "' \\t\\n\\r\\x0b\\x0c'"
                }
            ],
            "urlSuffix": "#string.whitespace"
        }
    ]
} 