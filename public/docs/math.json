        },
        {
            "kind": "constant",
            "name": "nan",
            "type": "float",
            "description": {
                "p": ["Floating-point value representing 'Not a Number' (NaN).",
                      "According to the IEEE 754 standard, NaN is not equal to any value, including itself. Use the `isnan` function to check for NaN values."]
            },
            "examples": [
