{
    "module": "math",
    "summary": "Basic mathematical functions and constants",
    "officialBaseUrl": "https://docs.python.org/3/library/math.html",
    "elements": [
        {
            "kind": "function",
            "name": "sin",
            "description": {
                "p": ["Returns the sine of the given angle."]
            },
            "parameters": [
                {
                    "name": "angle",
                    "type": "int | float",
                    "description": "angle in radians"
                }
            ],
            "returnValue": {
                "type": "float",
                "description": "sine of the angle"
            },
            "examples": [
                {
                    "code": "sin(0)",
                    "result": "0.0"
                },
                {
                    "code": "sin(pi / 2)",
                    "result": "1.0"
                }
            ],
            "urlSuffix": "#math.sin"
        },
        {
            "kind": "function",
            "name": "cos",
            "description": {
                "p": ["Returns the cosine of the given angle."]
            },
            "parameters": [
                {
                    "name": "angle",
                    "type": "int | float",
                    "description": "angle in radians"
                }
            ],
            "returnValue": {
                "type": "float",
                "description": "cosine of the angle"
            },
            "examples": [
                {
                    "code": "cos(0)",
                    "result": "1.0"
                },
                {
                    "code": "cos(pi)",
                    "result": "-1.0"
                }
            ],
            "urlSuffix": "#math.cos"
        },
        {
            "kind": "function",
            "name": "tan",
            "description": {
                "p": ["Returns the tangent of the given angle."]
            },
            "parameters": [
                {
                    "name": "angle",
                    "type": "int | float",
                    "description": "angle in radians"
                }
            ],
            "returnValue": {
                "type": "float",
                "description": "tangent of the angle"
            },
            "examples": [
                {
                    "code": "tan(0)",
                    "result": "0.0"
                },
                {
                    "code": "tan(pi / 4)",
                    "result": "1.0"
                }
            ],
            "urlSuffix": "#math.tan"
        },
        {
            "kind": "function",
            "name": "asin",
            "description": {
                "p": ["Returns the arcsine of the given value."]
            },
            "parameters": [
                {
                    "name": "value",
                    "type": "int | float",
                    "description": "value between -1 and 1"
                }
            ],
            "returnValue": {
                "type": "float",
                "description": "angle in radians"
            },
            "examples": [
                {
                    "code": "asin(0)",
                    "result": "0.0"
                },
                {
                    "code": "asin(1)",
                    "result": "1.5707963267948966"
                }
            ],
            "urlSuffix": "#math.asin"
        },
        {
            "kind": "function",
            "name": "acos",
            "description": {
                "p": ["Returns the arccosine of the given value."]
            },
            "parameters": [
                {
                    "name": "value",
                    "type": "int | float",
                    "description": "value between -1 and 1"
                }
            ],
            "returnValue": {
                "type": "float",
                "description": "angle in radians"
            },
            "examples": [
                {
                    "code": "acos(1)",
                    "result": "0.0"
                },
                {
                    "code": "acos(0)",
                    "result": "1.5707963267948966"
                }
            ],
            "urlSuffix": "#math.acos"
        },
        {
            "kind": "function",
            "name": "radians",
            "description": {
                "p": ["Converts the given angle from degrees to radians."]
            },
            "parameters": [
                {
                    "name": "angle",
                    "type": "float",
                    "description": "angle in degrees"
                }
            ],
            "returnValue": {
                "type": "float",
                "description": "angle in radians"
            },
            "examples": [
                {
                    "code": "radians(180)",
                    "result": "3.141592653589793"
                },
                {
                    "code": "radians(360)",
                    "result": "6.283185307179586"
                }
            ],
            "urlSuffix": "#math.radians"
        },
        {
            "kind": "function",
            "name": "degrees",
            "description": {
                "p": ["Converts the given angle from radians to degrees."]
            },
            "parameters": [
                {
                    "name": "angle",
                    "type": "float",
                    "description": "angle in radians"
                }
            ],
            "returnValue": {
                "type": "float",
                "description": "angle in degrees"
            },
            "examples": [
                {
                    "code": "degrees(pi)",
                    "result": "180.0"
                },
                {
                    "code": "degrees(pi / 2)",
                    "result": "90.0"
                }
            ],
            "urlSuffix": "#math.degrees"
        },
        {
            "kind": "function",
            "name": "log",
            "description": {
                "p": ["Returns the logarithm of the given value.", "Unless a different base is provided, computes the natural logarithm."]
            },
            "parameters": [
                {
                    "name": "x",
                    "type": "int | float",
                    "description": "value to compute the logarithm of"
                },
                {
                    "name": "base",
                    "type": "int | float",
                    "description": "base of the logarithm",
                    "default": "e"
                }
            ],
            "returnValue": {
                "type": "float",
                "description": "logarithm of the provided value"
            },
            "examples": [
                {
                    "code": "log(e)",
                    "result": "1.0"
                },
                {
                    "code": "log(100, 10)",
                    "result": "2.0",
                    "usesOptional": true
                }
            ],
            "urlSuffix": "#math.log"
        },
        {
            "kind": "function",
            "name": "sqrt",
            "description": {
                "p": ["Returns the square root of the given number."]
            },
            "parameters": [
                {
                    "name": "x",
                    "type": "int | float",
                    "description": "number to compute the square root of"
                }
            ],
            "returnValue": {
                "type": "float",
                "description": "square root of the provided number"
            },
            "examples": [
                {
                    "code": "sqrt(4)",
                    "result": "2.0"
                },
                {
                    "code": "sqrt(2)",
                    "result": "1.4142135623730951"
                }
            ],
            "urlSuffix": "#math.sqrt"
        },
        {
            "kind": "function",
            "name": "exp",
            "description": {
                "p": ["Returns the exponential of the given number."]
            },
            "parameters": [
                {
                    "name": "x",
                    "type": "int | float",
                    "description": "exponent of the formula eˣ"
                }
            ],
            "returnValue": {
                "type": "float",
                "description": "exponential of the provided number"
            },
            "examples": [
                {
                    "code": "exp(0)",
                    "result": "1.0"
                },
                {
                    "code": "exp(1)",
                    "result": "2.718281828459045"
                }
            ],
            "urlSuffix": "#math.exp"
        },
        {
            "kind": "function",
            "name": "isclose",
            "description": {
                "p": ["Returns True if two values are approximately equal: close to each other within a tolerance.",
                      "Two values are close if their absolute difference is not greater than the highest between the relative and absolute tolerances."]
            },
            "parameters": [
                {
                    "name": "a",
                    "type": "float",
                    "description": "first value to compare"
                },
                {
                    "name": "b",
                    "type": "float",
                    "description": "second value to compare"
                },
                {
                    "name": "rel_tol",
                    "type": "float",
                    "description": "relative tolerance: the maximum allowed difference as a fraction of the larger absolute value",
                    "default": "1e-09"
                },
                {
                    "name": "abs_tol",
                    "type": "float",
                    "description": "absolute tolerance: the maximum allowed difference between the two values", 
                    "default": "0.0"
                }
            ],
            "returnValue": {
                "type": "bool",
                "description": "True if the two values are close to each other, False otherwise"
            },
            "examples": [
                {
                    "code": "isclose(3.01, 3)",
                    "result": "False"
                },
                {
                    "code": "isclose(0.1 + 0.2, 0.3)",
                    "result": "True"
                },
                {
                    "code": "isclose(10, 11, rel_tol=0.1, abs_tol=0)",
                    "result": "True",
                    "usesOptional": true
                },
                {
                    "code": "isclose(10, 11, rel_tol=0.01, abs_tol=1)",
                    "result": "True",
                    "usesOptional": true
                }
            ],
            "urlSuffix": "#math.isclose"
        },
        {
            "kind": "function",
            "name": "isnan",
            "description": {
                "p": ["Returns True if the given value is 'Not a Number' (NaN)."]
            },
            "parameters": [
                {
                    "name": "num",
                    "type": "float",
                    "description": "number to check"
                }
            ],
            "returnValue": {
                "type": "bool",
                "description": "True if the value is NaN, False otherwise"
            },
            "examples": [
                {
                    "code": "isnan(nan)",
                    "result": "True"
                },
                {
                    "code": "isnan(inf)",
                    "result": "False"
                }
            ],
            "urlSuffix": "#math.isnan"
        },
        {
            "kind": "function",
            "name": "isinf",
            "description": {
                "p": ["Returns True if the given value represents positive or negative infinity."]
            },
            "parameters": [
                {
                    "name": "num",
                    "type": "float",
                    "description": "number to check"
                }
            ],
            "returnValue": {
                "type": "bool",
                "description": "True if the value is infinite, False otherwise"
            },
            "examples": [
                {
                    "code": "isinf(inf)",
                    "result": "True"
                },
                {
                    "code": "isinf(-inf)",
                    "result": "True"
                },
                {
                    "code": "isinf(42)",
                    "result": "False"
                }
            ],
            "urlSuffix": "#math.isinf"
        },
