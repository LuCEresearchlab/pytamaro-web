{
    "module": "math",
    "summary": "Basic mathematical functions and constants",
    "officialBaseUrl": "https://docs.python.org/3/library/math.html",
    "elements": [
        {
            "kind": "function",
            "name": "sin",
            "description": {
                "p": ["Returns the sine of the given angle."]
            },
            "parameters": [
                {
                    "name": "angle",
                    "type": "int | float",
                    "description": "angle in radians"
                }
            ],
            "returnValue": {
                "type": "float",
                "description": "sine of the angle"
            },
            "examples": [
                {
                    "code": "sin(0)",
                    "result": "0.0"
                },
                {
                    "code": "sin(pi / 2)",
                    "result": "1.0"
                }
            ],
            "urlSuffix": "#math.sin"
        },
        {
            "kind": "function",
            "name": "cos",
            "description": {
                "p": ["Returns the cosine of the given angle."]
            },
            "parameters": [
                {
                    "name": "angle",
                    "type": "int | float",
                    "description": "angle in radians"
                }
            ],
            "returnValue": {
                "type": "float",
                "description": "cosine of the angle"
            },
            "examples": [
                {
                    "code": "cos(0)",
                    "result": "1.0"
                },
                {
                    "code": "cos(pi)",
                    "result": "-1.0"
                }
            ],
            "urlSuffix": "#math.cos"
        },
        {
            "kind": "function",
            "name": "tan",
            "description": {
                "p": ["Returns the tangent of the given angle."]
            },
            "parameters": [
                {
                    "name": "angle",
                    "type": "int | float",
                    "description": "angle in radians"
                }
            ],
            "returnValue": {
                "type": "float",
                "description": "tangent of the angle"
            },
            "examples": [
                {
                    "code": "tan(0)",
                    "result": "0.0"
                },
                {
                    "code": "tan(pi / 4)",
                    "result": "1.0"
                }
            ],
            "urlSuffix": "#math.tan"
        },
        {
            "kind": "function",
            "name": "asin",
            "description": {
                "p": ["Returns the arcsine of the given value."]
            },
            "parameters": [
                {
                    "name": "value",
                    "type": "int | float",
                    "description": "value between -1 and 1"
                }
            ],
            "returnValue": {
                "type": "float",
                "description": "angle in radians"
            },
            "examples": [
                {
                    "code": "asin(0)",
                    "result": "0.0"
                },
                {
                    "code": "asin(1)",
                    "result": "1.5707963267948966"
                }
            ],
            "urlSuffix": "#math.asin"
        },
        {
            "kind": "function",
            "name": "acos",
            "description": {
                "p": ["Returns the arccosine of the given value."]
            },
            "parameters": [
                {
                    "name": "value",
                    "type": "int | float",
                    "description": "value between -1 and 1"
                }
            ],
            "returnValue": {
                "type": "float",
                "description": "angle in radians"
            },
            "examples": [
                {
                    "code": "acos(1)",
                    "result": "0.0"
                },
                {
                    "code": "acos(0)",
                    "result": "1.5707963267948966"
                }
            ],
            "urlSuffix": "#math.acos"
        },
        {
            "kind": "function",
            "name": "radians",
            "description": {
                "p": ["Converts the given angle from degrees to radians."]
            },
            "parameters": [
                {
                    "name": "angle",
                    "type": "float",
                    "description": "angle in degrees"
                }
            ],
            "returnValue": {
                "type": "float",
                "description": "angle in radians"
            },
            "examples": [
                {
                    "code": "radians(180)",
                    "result": "3.141592653589793"
                },
                {
                    "code": "radians(360)",
                    "result": "6.283185307179586"
                }
            ],
            "urlSuffix": "#math.radians"
        },
        {
            "kind": "function",
            "name": "degrees",
            "description": {
                "p": ["Converts the given angle from radians to degrees."]
            },
            "parameters": [
                {
                    "name": "angle",
                    "type": "float",
                    "description": "angle in radians"
                }
            ],
            "returnValue": {
                "type": "float",
                "description": "angle in degrees"
            },
            "examples": [
                {
                    "code": "degrees(pi)",
                    "result": "180.0"
                },
                {
                    "code": "degrees(pi / 2)",
                    "result": "90.0"
                }
            ],
            "urlSuffix": "#math.degrees"
        },
        {
            "kind": "function",
            "name": "log",
            "description": {
                "p": ["Returns the logarithm of the given value.", "Unless a different base is provided, computes the natural logarithm."]
            },
            "parameters": [
                {
                    "name": "x",
                    "type": "int | float",
                    "description": "value to compute the logarithm of"
                },
                {
                    "name": "base",
                    "type": "int | float",
                    "description": "base of the logarithm",
                    "default": "e"
                }
            ],
            "returnValue": {
                "type": "float",
                "description": "logarithm of the provided value"
            },
            "examples": [
                {
                    "code": "log(e)",
                    "result": "1.0"
                },
                {
                    "code": "log(100, 10)",
                    "result": "2.0",
                    "usesOptional": true
                }
            ],
            "urlSuffix": "#math.log"
        },
        {
            "kind": "function",
            "name": "sqrt",
            "description": {
                "p": ["Returns the square root of the given number."]
            },
            "parameters": [
                {
                    "name": "x",
                    "type": "int | float",
                    "description": "number to compute the square root of"
                }
            ],
            "returnValue": {
                "type": "float",
                "description": "square root of the provided number"
            },
            "examples": [
                {
                    "code": "sqrt(4)",
                    "result": "2.0"
                },
                {
                    "code": "sqrt(2)",
                    "result": "1.4142135623730951"
                }
            ],
            "urlSuffix": "#math.sqrt"
        },
        {
            "kind": "function",
            "name": "exp",
            "description": {
                "p": ["Returns the exponential of the given number."]
            },
            "parameters": [
                {
                    "name": "x",
                    "type": "int | float",
                    "description": "exponent of the formula eˣ"
                }
            ],
            "returnValue": {
                "type": "float",
                "description": "exponential of the provided number"
            },
            "examples": [
                {
                    "code": "exp(0)",
                    "result": "1.0"
                },
                {
                    "code": "exp(1)",
                    "result": "2.718281828459045"
                }
            ],
            "urlSuffix": "#math.exp"
        },
        {
            "kind": "constant",
            "name": "pi",
            "type": "float",
            "description": {
                "p": ["The mathematical constant π = 3.141592…"]
            },
            "examples": [
                {
                    "code": "pi",
                    "result": "3.141592653589793"
                }
            ],
            "urlSuffix": "#math.pi"
        },
        {
            "kind": "constant",
            "name": "tau",
            "type": "float",
            "description": {
                "p": ["The mathematical constant τ = 6.283185…",
                      "τ is the ratio of a circle's circumference to its radius, and is equal to 2π."]
            },
            "examples": [
                {
                    "code": "tau",
                    "result": "6.283185307179586"
                }
            ],
            "urlSuffix": "#math.tau"
        },
        {
            "kind": "constant",
            "name": "e",
            "type": "float",
            "description": {
                "p": ["The mathematical constant e = 2.718281…"]
            },
            "examples": [
                {
                    "code": "e",
                    "result": "2.718281828459045"
                }
            ],
            "urlSuffix": "#math.e"
        }
    ]
} 