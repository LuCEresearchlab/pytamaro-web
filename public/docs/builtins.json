        {
            "kind": "function",
            "name": "sum",
            "description": {
                "p": [
                    "Returns the sum of the numbers in a sequence."
                ]
            },
            "parameters": [
                {
                    "name": "sequence",
                    "type": "Sequence[int | float]",
                    "description": "sequence of numbers"
                },
                {
                    "name": "start",
                    "type": "int | float",
                    "description": "initial value for the sum",
                    "default": "0"
                }
            ],
            "returnValue": {
                "type": "int | float",
                "description": "the sum of the elements"
            },
            "examples": [
                {
                    "code": "sum([12.5, 2, 0.5])",
