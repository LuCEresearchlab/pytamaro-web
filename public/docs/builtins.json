                    "usesOptional": true
                }
            ],
            "urlSuffix": "#min"
        },
        {
            "kind": "function",
            "name": "pow",
            "description": {
                "p": [
                    "Returns the result of raising a number to a power.",
                    "If a modulo is specified, the result is the remainder of the division by the modulo, efficiently computed."
                ]
            },
            "parameters": [
                {
                    "name": "base",
                    "type": "int | float",
                    "description": "base of the exponentiation"
                },
                {
                    "name": "exponent",
