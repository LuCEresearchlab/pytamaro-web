            "parameters": [
                {
                    "name": "first_value",
                    "type": "Sequence[T] | T",
                    "description": "sequence of elements or just a single value"
                },
                {
                    "name": "value",
                    "type": "T",
                    "description": "additional values to compare",
                    "variableLength": true
                },
                {
                    "name": "key",
                    "type": "T -> K",
                    "description": "optional function to extract the comparison key from the elements",
                    "default": "None"
                }
            ],
            "returnValue": {
                "type": "T",
                "description": "the minimum value"
            },
            "examples": [
                {
                    "code": "min([3, -5, 4])",
                    "result": "-5"
                },
                {
                    "code": "min(10, 11)",
                    "result": "10",
                    "usesOptional": true
                },
                {
                    "code": "min([('Lugano', 70_000), ('Bergamo', 120_000)], key=lambda city: city[1])",
