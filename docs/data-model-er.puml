@startuml
' hide the spot
hide circle

' avoid problems with angled crows feet
skinparam linetype ortho

entity "Author" as author {
  *slug : text
  --
  *name : text
  email : text
}

entity "Course" as course {
  *slug : text
  --
  *name : text
  *institution : text
  *instructors : text[]
  *assignments : slug[]
  *curricula : slug[]
}
entity "Assignment" as assignment {
  *slug : text
  --
  *name : text
  *url : text
  *activities : slug[]
}
entity "Curriculum" as curriculum {
  *slug : text
  --
  *title : text
  *description : text
  *visibility : text
  *competencies : slug[]
  *units : slug[]
}
entity "Unit" as unit {
  *slug : text
  --
  *title : text
  *curriculumActivities : slug[]
}
entity "CurriculumActivity" as curriculumactivity {
  *slug : text
  --
  *id : slug
  *activityRequirements : slug[][]
  *prerequisites : slug[]
  *learningObjectives : slug[]
}
entity "Competencies" as competencies {
  *slug : text
  --
  *name : text
  *description : text
  *longDescription : text
  *icon : text
}
entity "Activity" as activity {
  *slug : text
  --
  ' see https://progmiscon.org/concepts
  *concepts : text[] 
  ...
}


author ||--o{ course
author ||--o{ assignment
author ||--o{ curriculum
author ||--o{ activity

course }o--o{ assignment
course }o--o{ curriculum

assignment }o--o{ activity

curriculum ||--o{ unit
curriculum ||--o{ competencies

unit ||--o{ curriculumactivity

curriculumactivity }o--|| activity
@enduml
