{
  "name": "pytamaro-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "npm run check-donow && npm run create-assets",
    "check-donow": "cross-env NODE_OPTIONS=--experimental-wasm-modules node --no-warnings --loader ts-node/esm tools/checkNotebookDoNow.mts",
    "create-assets": "cross-env NODE_OPTIONS=--experimental-wasm-modules node --no-warnings --loader ts-node/esm tools/createNotebookAssets.mts",
    "build": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" next build",
    "start": "next start",
    "lint": "next lint",
    "cypress": "cypress open",
    "build-python-analyzer": "wasm-pack build tools/python-analyzer --target bundler --out-dir ../../src/python-analyzer && rm src/python-analyzer/.gitignore"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.0",
    "@floating-ui/react": "^0.26.23",
    "@fontsource-variable/fira-code": "^5.0.20",
    "@fontsource/fira-sans": "^5.0.2",
    "@fontsource/material-icons": "^5.0.18",
    "@formatjs/intl-localematcher": "^0.5.1",
    "@hapi/topo": "^6.0.2",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^7.2.0",
    "@mui/material": "^7.2.0",
    "@mui/material-nextjs": "^7.2.0",
    "@sentry/nextjs": "^9.12.0",
    "@tanstack/react-query": "^5.70.0",
    "@types/animejs": "^3.1.7",
    "@types/uuid": "^9.0.1",
    "@xyflow/react": "^12.5.1",
    "animejs": "^3.2.1",
    "axios": "^1.1.3",
    "canvaskit-wasm": "^0.40.0",
    "copy-webpack-plugin": "^11.0.0",
    "embla-carousel-autoplay": "^8.5.2",
    "embla-carousel-fade": "^8.5.2",
    "embla-carousel-react": "^8.5.2",
    "file-saver": "^2.0.5",
    "github-slugger": "^2.0.0",
    "i18next": "^25.3.2",
    "immer": "^9.0.18",
    "jszip": "^3.10.1",
    "lodash": "^4.17.21",
    "material-ui-confirm": "^3.0.18",
    "next": "15.5.2",
    "next-i18next": "^15.4.2",
    "next-mdx-remote": "^5.0.0",
    "next-plausible": "^3.12.4",
    "p-queue": "^8.1.1",
    "postgres": "^3.3.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^15.6.1",
    "react-markdown": "^8.0.3",
    "react-resize-detector": "^12.0.2",
    "redis": "^4.5.1",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.32.6",
    "use-local-storage-state": "^18.3.3",
    "use-session-storage-state": "^18.2.0",
    "uuid": "^9.0.0",
    "web-worker": "^1.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.5",
    "@types/lodash": "^4.14.194",
    "@types/node": "18.11.6",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "cross-env": "^7.0.3",
    "cypress": "^15.1.0",
    "dotenv": "^16.3.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.2.4",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-cypress": "^3.6.0",
    "eslint-plugin-prettier": "^5.2.5",
    "monaco-editor": "^0.46.0",
    "prettier": "^3.5.3",
    "pyodide": "^0.28.3",
    "simple-git": "^3.14.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.5.4"
  },
  "browserslist": [
    "defaults and supports es6-module"
  ]
}
