{
  "name": "pytamaro-web",
  "version": "1.0.0",
  "description": "PyTamaro Web platform",
  "license": "MIT",
  "private": true,
  "author": "LuCE, Lugano Computing Education Research Lab, Università della Svizzera italiana (USI)",
  "homepage": "https://pytamaro.si.usi.ch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuCEresearchlab/pytamaro-web.git"
  },
  "bugs": {
    "url": "https://github.com/LuCEresearchlab/pytamaro-web/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run check-donow && npm run create-assets",
    "check-donow": "cross-env NODE_OPTIONS=--experimental-wasm-modules node --no-warnings --loader ts-node/esm tools/checkNotebookDoNow.mts",
    "create-assets": "cross-env NODE_OPTIONS=--experimental-wasm-modules node --no-warnings --loader ts-node/esm tools/createNotebookAssets.mts",
    "build": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" next build",
    "start": "next start",
    "lint": "eslint",
    "cypress": "cypress open",
    "build-python-analyzer": "wasm-pack build tools/python-analyzer --target bundler --out-dir ../../src/python-analyzer && rm src/python-analyzer/.gitignore"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.0",
    "@floating-ui/react": "^0.27.16",
    "@fontsource-variable/fira-code": "^5.2.7",
    "@fontsource/fira-sans": "^5.2.7",
    "@fontsource/material-icons": "^5.2.7",
    "@formatjs/intl-localematcher": "^0.5.1",
    "@hapi/topo": "^6.0.2",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/material-nextjs": "^9.4.0",
    "@mui/x-tree-view": "^9.15.0",
    "@sentry/nextjs": "^11.13.0",
    "@tanstack/react-query": "^5.70.0",
    "@xyflow/react": "^12.5.1",
    "animejs": "^3.2.1",
    "axios": "^1.21.1",
    "disposablestack": "^1.1.7",
    "embla-carousel-autoplay": "^8.5.2",
    "embla-carousel-fade": "^8.5.2",
    "embla-carousel-react": "^8.5.2",
    "file-saver": "^2.0.5",
    "github-slugger": "^2.0.0",
    "i18next": "^27.1.3",
    "immer": "^9.0.18",
    "jszip": "^3.10.1",
    "lodash": "^4.17.21",
    "material-ui-confirm": "^4.0.0",
    "next": "~16.4.6",
    "next-i18next": "^16.4.10",
    "next-mdx-remote": "^6.0.0",
    "next-plausible": "^3.12.5",
    "p-queue": "^8.1.1",
    "postgres": "^3.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "^18.0.2",
    "react-resizable-panels": "^4.12.4",
    "react-resize-detector": "^12.0.2",
    "remark-gfm": "^4.0.1",
    "use-local-storage-state": "^19.5.0",
    "use-session-storage-state": "^19.0.1",
    "uuid": "^14.0.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/animejs": "^3.1.7",
    "@types/file-saver": "^2.0.5",
    "@types/lodash": "^4.14.194",
    "@types/node": "18.11.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "cross-env": "^7.0.3",
    "cypress": "^16.3.0",
    "dotenv": "^16.3.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^5.2.0",
    "eslint-plugin-react-google-translate": "^1.1.0",
    "monaco-editor": "^0.52.0",
    "prettier": "^3.5.3",
    "pyodide": "^0.29.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.5.4"
  },
  "browserslist": [
    "defaults and supports es6-module"
  ]
}
