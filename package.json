{
  "name": "pytamaro-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "prebuild": "npm run validate-notebooks && npm run create-assets",
    "validate-notebooks": "npm run check-donow && npm run check-python-sources",
    "check-donow": "cross-env NODE_OPTIONS=--experimental-wasm-modules node --no-warnings --loader ts-node/esm tools/checkNotebookDoNow.mts",
    "check-python-sources": "cross-env NODE_OPTIONS=--experimental-wasm-modules node --no-warnings --loader ts-node/esm tools/checkNotebookSourceCode.mts",
    "create-assets": "cross-env NODE_OPTIONS=--experimental-wasm-modules node --no-warnings --loader ts-node/esm tools/createNotebookAssets.mts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "cypress": "cypress open",
    "build-python-analyzer": "wasm-pack build tools/python-analyzer --target bundler --out-dir ../../src/python-analyzer && rm src/python-analyzer/.gitignore"
  },
  "dependencies": {
    "@emotion/cache": "^11.10.5",
    "@emotion/react": "^11.10.5",
    "@emotion/server": "^11.10.0",
    "@emotion/styled": "^11.10.5",
    "@floating-ui/react": "^0.26.23",
    "@fontsource-variable/fira-code": "^5.0.20",
    "@fontsource/fira-sans": "^5.0.2",
    "@fontsource/material-icons": "^5.0.18",
    "@formatjs/intl-localematcher": "^0.5.1",
    "@hapi/topo": "^6.0.2",
    "@monaco-editor/react": "^4.5.1",
    "@mui/icons-material": "^5.15.7",
    "@mui/lab": "^5.0.0-alpha.115",
    "@mui/material": "^5.15.7",
    "@sentry/nextjs": "^8.34.0",
    "@tanstack/react-query": "^4.28.0",
    "@types/animejs": "^3.1.7",
    "@types/uuid": "^9.0.1",
    "animejs": "^3.2.1",
    "axios": "^1.1.3",
    "file-saver": "^2.0.5",
    "github-slugger": "^2.0.0",
    "i18next": "^23.6.0",
    "immer": "^9.0.18",
    "jszip": "^3.10.1",
    "lodash": "^4.17.21",
    "material-ui-confirm": "^3.0.8",
    "next": "^14.1.0",
    "next-i18next": "^15.0.0",
    "next-mdx-remote": "^4.4.1",
    "next-plausible": "^3.11.3",
    "postgres": "^3.3.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^13.3.1",
    "react-markdown": "^8.0.3",
    "react-material-ui-carousel": "^3.4.2",
    "react-player": "^2.12.0",
    "react-resize-detector": "^11.0.1",
    "reactflow": "^11.11.4",
    "redis": "^4.5.1",
    "remark-gfm": "^3.0.1",
    "sharp": "^0.32.6",
    "use-local-storage-state": "^18.3.3",
    "use-session-storage-state": "^18.2.0",
    "uuid": "^9.0.0",
    "web-worker": "^1.2.0"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.5",
    "@types/lodash": "^4.14.194",
    "@types/node": "18.11.6",
    "@types/react": "18.0.23",
    "@types/react-dom": "18.0.7",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "cross-env": "^7.0.3",
    "cypress": "^13.4.0",
    "dotenv": "^16.3.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.2.4",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-cypress": "^3.6.0",
    "eslint-plugin-prettier": "^5.2.5",
    "monaco-editor": "^0.46.0",
    "prettier": "^3.5.3",
    "simple-git": "^3.14.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.5.4"
  },
  "browserslist": [
    "defaults and supports es6-module"
  ]
}
